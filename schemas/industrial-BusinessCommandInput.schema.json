{
  "$defs": {
    "BusinessActionPayload": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "retest.create",
            "inventory.reserve",
            "inventory.release",
            "purchase.draft",
            "purchase.submit"
          ],
          "title": "Action",
          "type": "string"
        },
        "target_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "target_version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Target Version",
          "type": "string"
        },
        "material_id": {
          "default": "",
          "maxLength": 100,
          "title": "Material Id",
          "type": "string"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "decimal_places": 9,
          "default": "0",
          "ge": 0,
          "max_digits": 28,
          "title": "Quantity"
        },
        "unit": {
          "default": "",
          "maxLength": 20,
          "title": "Unit",
          "type": "string"
        },
        "reference_id": {
          "default": "",
          "maxLength": 160,
          "title": "Reference Id",
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 3,
          "title": "Reason",
          "type": "string"
        },
        "unit_price": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ],
              "decimal_places": 9,
              "ge": 0,
              "max_digits": 28
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Price"
        },
        "currency": {
          "default": "CNY",
          "maxLength": 10,
          "minLength": 3,
          "title": "Currency",
          "type": "string"
        },
        "tax_basis": {
          "default": "tax_exclusive",
          "enum": [
            "tax_inclusive",
            "tax_exclusive"
          ],
          "title": "Tax Basis",
          "type": "string"
        },
        "tax_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "decimal_places": 9,
          "default": "0",
          "ge": 0,
          "lt": 1,
          "max_digits": 28,
          "title": "Tax Rate"
        }
      },
      "required": [
        "action",
        "target_id",
        "target_version",
        "reason"
      ],
      "title": "BusinessActionPayload",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "line_id": {
      "title": "Line Id",
      "type": "string"
    },
    "connector_id": {
      "title": "Connector Id",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/BusinessActionPayload"
    },
    "policy_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Policy Id"
    },
    "approval_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approval Id"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Evidence Ids",
      "type": "array"
    },
    "prerequisite_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "title": "Prerequisite Ids",
      "type": "array"
    },
    "expected_result": {
      "enum": [
        "work_order_created",
        "inventory_reserved",
        "inventory_released",
        "purchase_draft_created",
        "purchase_submitted"
      ],
      "title": "Expected Result",
      "type": "string"
    }
  },
  "required": [
    "line_id",
    "connector_id",
    "payload",
    "expected_result"
  ],
  "title": "BusinessCommandInput",
  "type": "object"
}