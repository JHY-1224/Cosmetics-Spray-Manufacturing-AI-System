# Copy to a private file. Do not commit real credentials. All model calls are server-side.
ASSISTANT_HOST=127.0.0.1
ASSISTANT_PORT=5001
ASSISTANT_PUBLIC_ORIGIN=http://127.0.0.1:5001
ASSISTANT_SECURE_COOKIE=false
# ASSISTANT_DATA_DIR=/absolute/path/to/assistant-private-data
ASSISTANT_TEXT_MODEL_BASE_URL=http://127.0.0.1:5101/v1
ASSISTANT_VISION_MODEL_BASE_URL=http://127.0.0.1:5102/v1
ASSISTANT_MODEL_HOSTS=127.0.0.1,localhost,::1
ASSISTANT_TEXT_SERVED_MODEL=cosmetics-qwen35-9b
ASSISTANT_VISION_SERVED_MODEL=cosmetics-qwen3-vl-8b
ASSISTANT_TEXT_MODE=finetuned_lora
ASSISTANT_ALLOW_BASE_PREVIEW=false
# Set the REAL paths for your server; these example paths are not auto-created.
ASSISTANT_TEXT_MODEL_PATH=/root/autodl-tmp/models/Qwen3.5-9B
ASSISTANT_VISION_MODEL_PATH=/root/autodl-tmp/models/Qwen3-VL-8B-Instruct
# Unified model discovery and optional per-model backend profiles:
# ASSISTANT_MODEL_DIRECTORY=/root/autodl-tmp/models
# ASSISTANT_MODEL_PROFILES_DIR=/absolute/path/to/assistant_app/configs/model_profiles
ASSISTANT_LOCAL_TEXT_MODEL_BASE_URL=http://127.0.0.1:5101/v1
ASSISTANT_LOCAL_VISION_MODEL_BASE_URL=http://127.0.0.1:5102/v1
ASSISTANT_LOCAL_TEXT_SERVED_MODEL=cosmetics-qwen35-9b
ASSISTANT_LOCAL_VISION_SERVED_MODEL=cosmetics-qwen3-vl-8b
# ASSISTANT_TEXT_ADAPTER_PATH=/actual/9b/run/adapter
# ASSISTANT_TEXT_MERGED_MODEL_PATH=/actual/9b/run/merged
# ASSISTANT_MODEL_VERIFICATION_FILE=/actual/private/model-check.json
ASSISTANT_MAX_IMAGES=3
ASSISTANT_CONCURRENCY=2
ASSISTANT_BODY_CONCURRENCY=8
ASSISTANT_VISION_MAX_OUTPUT_TOKENS=4096
ASSISTANT_QUEUE_LIMIT=8
ASSISTANT_REQUEST_TIMEOUT=180
ASSISTANT_MODEL_TIMEOUT=60
ASSISTANT_TTL_SECONDS=86400
ASSISTANT_FEISHU_TRANSPORT=disabled
# FEISHU_TRANSPORT=ws is preferred; http requires signed AES encrypted callbacks.
# ASSISTANT_FEISHU_APP_ID=
# ASSISTANT_FEISHU_APP_SECRET=
# ASSISTANT_FEISHU_ENCRYPT_KEY=
# ASSISTANT_FEISHU_VERIFICATION_TOKEN=
# ASSISTANT_FEISHU_BRIDGE_SECRET=
# ASSISTANT_FEISHU_BOT_OPEN_ID=
# ASSISTANT_FEISHU_TENANTS=allowed-tenant
# ASSISTANT_FEISHU_USERS=allowed-user-open-id
# ASSISTANT_FEISHU_CHATS=allowed-group-chat-id

# Remote access requires a real authenticated reverse proxy; never expose this value to frontend.
# ASSISTANT_GATEWAY_KEY=<independent-random-secret-at-least-32-characters>
# The proxy must OVERWRITE X-Assistant-Gateway-Key and X-Assistant-User after authenticating a user.
