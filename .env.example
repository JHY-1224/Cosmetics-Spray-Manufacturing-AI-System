# 开发演示。复制为.env后根据部署环境填写；生产配置必须使用客户配置生成器。
QUALITY_MODE=demo
QUALITY_NODE_ROLE=site
QUALITY_TENANT_ID=demo-customer
QUALITY_SITE_ID=factory-a
QUALITY_NODE_ID=site-a
QUALITY_DATABASE_URL=sqlite:///var/site.db
QUALITY_DATA_DIR=var
QUALITY_COOKIE_SECURE=false
QUALITY_APPROVED_HOSTS=["127.0.0.1","localhost"]
# 不配置模型时明确显示“模型增强未启用”，人工和规则业务继续。
QUALITY_MODEL_APPROVED=false
QUALITY_MODEL_URL=
QUALITY_MODEL_NAME=
QUALITY_MODEL_API_KEY=
QUALITY_MODEL_TIMEOUT=20
QUALITY_MODEL_MAX_OUTPUT_TOKENS=2500
QUALITY_MODEL_CONCURRENCY=2
# 默认仅可发送工艺/缺陷标签和授权引用ID；正文、备注、聚合特征等须由客户逐类批准。
QUALITY_MODEL_ALLOWED_DATA=["process_labels","evidence_references"]
QUALITY_EMBEDDING_URL=
QUALITY_EMBEDDING_MODEL=

# 案件模型预算为保守预留，价格单位由客户约定，不能替代供应商账单。
QUALITY_MAX_CASE_TOKENS=50000
QUALITY_MAX_CASE_COST=25
QUALITY_MODEL_COST_PER_1K=0
QUALITY_OFFLINE_AUTH_HOURS=24
QUALITY_SESSION_HOURS=8
# 仅需要应急时通过受控秘密配置至少32字符；留空表示禁用。
QUALITY_LOCAL_RECOVERY_KEY=
